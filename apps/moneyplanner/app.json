{
  "expo": {
    "name": "Money Planner",
    "slug": "moneyplanner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "moneyplanner",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.shefoo.moneyplanner",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1",
              "1C8F.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#7B4DFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.shefoo.moneyplanner",
      "versionCode": 1,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#7B4DFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Money Planner uses Face ID to unlock your profile, so only you can see its money data."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#5B4DFF"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Money Planner reads the statement or receipt photo you choose, on your phone only.",
          "cameraPermission": "Money Planner uses the camera to photograph a statement or receipt. The photo stays on your phone.",
          "microphonePermission": false
        }
      ],
      [
        "expo-sharing",
        {
          "android": {
            "enabled": true,
            "singleShareMimeTypes": [
              "application/pdf",
              "text/csv",
              "text/comma-separated-values",
              "text/plain",
              "image/*",
              "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
              "application/vnd.ms-excel",
              "application/x-ofx"
            ]
          },
          "ios": {
            "enabled": true,
            "appGroupId": "group.com.shefoo.moneyplanner",
            "activationRule": {
              "supportsFileWithMaxCount": 1,
              "supportsImageWithMaxCount": 1,
              "supportsText": true
            }
          }
        }
      ],
      "./plugins/with-mlkit-ocr-dependency",
      "./plugins/with-proguard-rules"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "shefoo0",
    "extra": {
      "eas": {
        "projectId": "2f93a6bc-a063-45de-bb24-61036399ff35"
      }
    }
  }
}
